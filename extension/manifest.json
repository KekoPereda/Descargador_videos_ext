{
  "manifest_version": 3,
  "name": "Descargador YouTube",
  "version": "1.0.0",
  "description": "Descarga audio (MP3) o video (MP4) de YouTube mediante un servidor local con yt-dlp.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Descargar de YouTube",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:8765/*"]
}
